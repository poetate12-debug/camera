<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <Button
        android:id="@+id/floatingBubble"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/floating_bubble"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="CAM"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/floatingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F0162635"
        android:padding="8dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/floatingHeader"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CAMERA CONTROL"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/floatingCollapseButton"
                android:layout_width="34dp"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="×"
                android:textSize="16sp" />
        </LinearLayout>
        <androidx.camera.view.PreviewView
            android:id="@+id/floatingPreviewView"
            android:layout_width="152dp"
            android:layout_height="86dp"
            android:layout_marginTop="4dp"
            android:background="#090E14"
            android:visibility="gone"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />
        <TextView
            android:id="@+id/floatingStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="SIAP"
            android:textColor="#FFDA78"
            android:textSize="10sp"
            android:textStyle="bold" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/floatingCameraLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="KAMERA BELAKANG"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/floatingQualityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080p"
                android:textColor="#AFC3D4"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/floatingRecButton"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:backgroundTint="#D9364A"
                android:text="● REC"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <Button
                android:id="@+id/floatingStopButton"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#455C70"
                android:text="■ STOP"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
            <Button
                android:id="@+id/floatingSwitchButton"
                android:layout_width="72dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#24506A"
                android:text="GANTI"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:text="Ketuk × untuk mengecilkan • geser judul untuk memindah"
            android:textColor="#90A7B9"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>