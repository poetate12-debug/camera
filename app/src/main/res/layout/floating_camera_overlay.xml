<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <Button
        android:id="@+id/floatingBubble"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/floating_bubble"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />
    <LinearLayout
        android:id="@+id/floatingControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F0162635"
        android:padding="8dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/floatingHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end">
            <Button
                android:id="@+id/floatingCollapseButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:text="×"
                android:textSize="14sp" />
        </LinearLayout>
        <androidx.camera.view.PreviewView
            android:id="@+id/floatingPreviewView"
            android:layout_width="152dp"
            android:layout_height="86dp"
            android:layout_marginTop="4dp"
            android:background="#090E14"
            android:visibility="gone"
            app:implementationMode="compatible"
            app:scaleType="fillCenter" />

        <TextView
            android:id="@+id/floatingStatusText"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/floatingCameraLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="KAMERA BELAKANG"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/floatingQualityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1080p"
                android:textColor="#AFC3D4"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="5dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <Button
                android:id="@+id/floatingRecButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:backgroundTint="#D9364A"
                android:text="●"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
            <Button
                android:id="@+id/floatingStopButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:backgroundTint="#455C70"
                android:text="■"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
            <Button
                android:id="@+id/floatingSwitchButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginTop="5dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:backgroundTint="#24506A"
                android:text="⇄"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />
        </LinearLayout>

    </LinearLayout>
</FrameLayout>