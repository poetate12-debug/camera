<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F0162635"
    android:padding="9dp">
    <LinearLayout
        android:id="@+id/floatingHeader"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="CAMERA PREVIEW"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textColor="#55E6C1"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
    <androidx.camera.view.PreviewView
        android:id="@+id/floatingPreviewView"
        android:layout_width="match_parent"
        android:layout_height="148dp"
        android:layout_marginTop="3dp"
        android:background="#090E14"
        app:implementationMode="compatible"
        app:scaleType="fillCenter" />
    <TextView
        android:id="@+id/floatingStatusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="PREVIEW AKTIF • BELUM MEREKAM"
        android:textColor="#FFDA78"
        android:textSize="10sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/floatingCameraLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KAMERA BELAKANG"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/floatingQualityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kualitas 1080p"
            android:textColor="#AFC3D4"
            android:textSize="10sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:orientation="horizontal">
        <Button
            android:id="@+id/floatingRecButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="1"
            android:backgroundTint="#D9364A"
            android:text="● REC"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />
        <Button
            android:id="@+id/floatingStopButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:backgroundTint="#455C70"
            android:text="■ STOP"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
        <Button
            android:id="@+id/floatingSwitchButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="5dp"
            android:layout_weight="1"
            android:backgroundTint="#24506A"
            android:text="GANTI"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:gravity="center"
        android:text="Geser panel melalui header untuk memindahkan posisi"
        android:textColor="#90A7B9"
        android:textSize="9sp" />
</LinearLayout>
