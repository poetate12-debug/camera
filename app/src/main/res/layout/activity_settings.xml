<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1420"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">
        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:backgroundTint="#1B3042"
            android:text="‹  KEMBALI"
            android:textColor="#EAF4FA" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="PENGATURAN"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Atur kamera, kualitas video, stabilisasi, dan kontrol mengambang."
            android:textColor="#8FA6BA"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#142536"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PREVIEW & TOMBOL MELAYANG"
                android:textColor="#F2F7FB"
                android:textSize="15sp"
                android:textStyle="bold" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/floatingSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Aktifkan tombol melayang"
                android:textColor="#F2F7FB"
                android:textSize="14sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/previewSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Tampilkan preview kamera mini"
                android:textColor="#F2F7FB"
                android:textSize="14sp" />
            <Button
                android:id="@+id/overlayPermissionButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#24506A"
                android:text="BERI IZIN TAMPIL DI ATAS APLIKASI"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Tombol melayang berbentuk bulatan. Ketuk untuk membuka REC, STOP, dan ganti kamera. Preview tidak tampil kecuali opsi preview mini diaktifkan."
                android:textColor="#8FA6BA"
                android:textSize="12sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#142536"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KAMERA"
                android:textColor="#F2F7FB"
                android:textSize="15sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/cameraChoiceText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Kamera aktif: BELAKANG"
                android:textColor="#8FA6BA"
                android:textSize="12sp" />
            <Button
                android:id="@+id/switchCameraButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#24506A"
                android:text="GANTI KAMERA"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#142536"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DUAL CAMERA"
                android:textColor="#F2F7FB"
                android:textSize="15sp"
                android:textStyle="bold" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/dualCameraSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Rekam kamera depan + belakang bersamaan"
                android:textColor="#F2F7FB"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Jika didukung perangkat, dua file video terpisah disimpan pada 720p. Jika tidak, aplikasi memberi pesan dan tidak memulai rekaman."
                android:textColor="#8FA6BA"
                android:textSize="12sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#142536"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="KUALITAS VIDEO"
                android:textColor="#F2F7FB"
                android:textSize="15sp"
                android:textStyle="bold" />
            <Spinner
                android:id="@+id/qualitySpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#FFFFFF" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Pilihan: 480p, 720p, 1080p, dan 4K. Kualitas akhir mengikuti dukungan kamera yang dipilih."
                android:textColor="#8FA6BA"
                android:textSize="12sp" />
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/stabilizationSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Stabilisasi video (jika didukung)"
                android:textColor="#F2F7FB"
                android:textSize="14sp" />
        </LinearLayout>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Catatan: kamera hanya dapat diganti saat rekaman berhenti. Mode dual membutuhkan dukungan perangkat dan menghasilkan dua file terpisah. Preview mini hanya aktif bila dipilih."
            android:textColor="#7893AA"
            android:textSize="11sp"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>
</ScrollView>
